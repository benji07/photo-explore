---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/links';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  date: Date;
  eyebrow: string; // libellé de catégorie
  backHref: string;
  backLabel: string;
  cover?: ImageMetadata | string; // ImageMetadata (local) ou URL externe (string)
  coverAlt?: string;
  coverCredit?: string; // crédit affiché en petit sous la couverture
  coverSource?: string; // lien vers la source : rend la couverture cliquable
  tags?: string[];
  meta?: string[]; // infos additionnelles (ex : nationalité, époque, difficulté)
  editUrl: string; // lien « Signaler une erreur » vers l'éditeur GitHub
}

const {
  title,
  description,
  date,
  eyebrow,
  backHref,
  backLabel,
  cover,
  coverAlt,
  coverCredit,
  coverSource,
  tags,
  meta,
  editUrl,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <a class="back-link" href={backHref}>← {backLabel}</a>

    <header class="article__header">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <div class="article__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {meta?.filter(Boolean).map((m) => <span>{m}</span>)}
      </div>
    </header>

    {
      cover && (
        <figure class="article__cover">
          <div class="article__cover-frame">
            {coverSource ? (
              <a href={coverSource} target="_blank" rel="noopener noreferrer">
                {typeof cover === 'string' ? (
                  <img src={cover} alt={coverAlt ?? title} width="1280" height="720" loading="lazy" />
                ) : (
                  <Image src={cover} alt={coverAlt ?? title} width={1280} height={720} />
                )}
              </a>
            ) : typeof cover === 'string' ? (
              <img src={cover} alt={coverAlt ?? title} width="1280" height="720" loading="lazy" />
            ) : (
              <Image src={cover} alt={coverAlt ?? title} width={1280} height={720} />
            )}
          </div>
          {coverCredit && (
            <figcaption class="figure__credit">
              {coverSource ? (
                <a href={coverSource} target="_blank" rel="noopener noreferrer">
                  {coverCredit}
                </a>
              ) : (
                coverCredit
              )}
            </figcaption>
          )}
        </figure>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      tags && tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }

    <footer class="article__report">
      <a href={editUrl} target="_blank" rel="noopener noreferrer" class="report-link">
        ✎ Une erreur ? Signaler ou proposer une correction sur GitHub
      </a>
    </footer>
  </article>
</BaseLayout>
