---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/links';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  date: Date;
  eyebrow: string; // libellé de catégorie
  backHref: string;
  backLabel: string;
  cover?: ImageMetadata | string; // ImageMetadata (local) ou URL externe (string)
  coverAlt?: string;
  tags?: string[];
  meta?: string[]; // infos additionnelles (ex : nationalité, époque, difficulté)
}

const { title, description, date, eyebrow, backHref, backLabel, cover, coverAlt, tags, meta } =
  Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <a class="back-link" href={backHref}>← {backLabel}</a>

    <header class="article__header">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <div class="article__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {meta?.filter(Boolean).map((m) => <span>{m}</span>)}
      </div>
    </header>

    {
      cover && (
        <figure class="article__cover">
          {typeof cover === 'string' ? (
            <img src={cover} alt={coverAlt ?? title} width="1280" height="720" loading="lazy" />
          ) : (
            <Image src={cover} alt={coverAlt ?? title} width={1280} height={720} />
          )}
        </figure>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      tags && tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
