---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { categoryByCollection } from '../../utils/categories';
import { getPublished } from '../../utils/content';
import { githubEditUrl, withBase } from '../../utils/links';

export async function getStaticPaths() {
  const entries = await getPublished('photographers');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cat = categoryByCollection('photographers')!;
const d = entry.data;

const meta = [d.nationality, d.era, d.genres.join(', ')].filter(Boolean);
---

<ArticleLayout
  title={d.title}
  description={d.description}
  date={d.date}
  eyebrow={cat.singular}
  backHref={withBase(`${cat.slug}/`)}
  backLabel={cat.label}
  cover={d.cover}
  coverAlt={d.coverAlt}
  coverCredit={d.coverCredit}
  coverSource={d.coverSource}
  tags={d.tags}
  meta={meta}
  editUrl={githubEditUrl('photographers', entry.id)}
>
  <Content />
</ArticleLayout>
