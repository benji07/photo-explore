---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublished } from '../../utils/content';
import { categoryByCollection } from '../../utils/categories';
import { withBase } from '../../utils/links';

const cat = categoryByCollection('techniques')!;
const entries = await getPublished('techniques');

const difficultyLabel: Record<string, string> = {
  debutant: 'Débutant',
  intermediaire: 'Intermédiaire',
  avance: 'Avancé',
};
---

<BaseLayout title={cat.label} description={cat.description}>
  <section class="hero">
    <span class="eyebrow">Rubrique</span>
    <h1>{cat.label}</h1>
    <p>{cat.description}</p>
  </section>

  {
    entries.length === 0 ? (
      <p class="empty">Bientôt des techniques détaillées ici.</p>
    ) : (
      <div class="card-grid">
        {entries.map((entry) => (
          <ArticleCard
            href={withBase(`${cat.slug}/${entry.id}/`)}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            cover={entry.data.cover}
            coverAlt={entry.data.coverAlt}
            meta={difficultyLabel[entry.data.difficulty]}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
